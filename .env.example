# ==============================================================================
# SAIMOON PORTFOLIO & CV MAKER - ENVIRONMENT VARIABLES
# ==============================================================================
# Instructions:
# 1. Copy this file to `.env` (it is git-ignored for your safety).
# 2. Fill in the values from your Firebase Console and Google Cloud Console.
# 3. Client variables (prefixed with VITE_) are accessible in the browser.
# 4. Server variables (functions secrets) MUST ONLY be deployed to Cloud Functions.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. FIREBASE WEB CLIENT CONFIGURATION (Client-Side)
# Get these from Firebase Console -> Project Settings -> General -> Your apps -> Web app
# ------------------------------------------------------------------------------
VITE_FIREBASE_API_KEY=AIzaSyExampleKey_ReplaceWithYourActualKey
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef123456
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# Optional: Firebase App Check debug token for local development testing
VITE_FIREBASE_APPCHECK_DEBUG_TOKEN=

# ------------------------------------------------------------------------------
# 2. BACKEND CLOUD FUNCTIONS API URL (Client-Side)
# The base URL of your deployed Cloud Functions 2nd Gen
# e.g., https://us-central1-your-project-id.cloudfunctions.net
# ------------------------------------------------------------------------------
VITE_FUNCTIONS_BASE_URL=http://127.0.0.1:5001/your-project-id/us-central1

# ------------------------------------------------------------------------------
# 3. SERVER SECRETS (Cloud Functions & Backend only - NEVER EXPOSE IN FRONTEND)
# ------------------------------------------------------------------------------
# Google Gemini API key from https://aistudio.google.com
GEMINI_API_KEY=your_gemini_api_key_here

# Google Drive Root Folder ID ("CV Maker Users" folder where user directories are created)
# Get from URL: https://drive.google.com/drive/folders/<GOOGLE_DRIVE_ROOT_FOLDER_ID>
GOOGLE_DRIVE_ROOT_FOLDER_ID=your_drive_folder_id_here

# Google Sheet ID for Admin Sync (Users & Payments tabs)
# Default is your existing portfolio sheet:
GOOGLE_SHEET_ID=1k8JqJooRpIbHBhgQS3-lSw502nNlwyokCX3P_oE3sHA

# Secret shared between Google Apps Script onEdit trigger and Cloud Functions webhook
# Used for HMAC-SHA256 signature verification
SHEETS_WEBHOOK_SECRET=create_a_random_32_char_secret_key_here

# Optional: Canva Connect API (Only if CANVA_ENABLED is true)
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=
